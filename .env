# Ansh Ayurveda — साइट सेटिंग
# ⚠️ यहाँ कुछ भी बदलने के बाद dev सर्वर रीस्टार्ट करें (या npm run build दोबारा चलाएं),
# तभी बदलाव पूरी वेबसाइट में एक साथ लागू होगा।
#
# ध्यान दें: VITE_ से शुरू होने वाले वेरिएबल ब्राउज़र में दिख सकते हैं,
# इसलिए यहाँ कोई पासवर्ड या गोपनीय (secret) जानकारी न रखें।

# डॉक्टर से बात करने / ऑर्डर सहायता का नंबर (देश कोड के साथ)
VITE_PHONE_NUMBER="+91 95121 05592"

# WhatsApp नंबर (देश कोड के साथ)
VITE_WHATSAPP_NUMBER=+919512105592

# ईमेल
VITE_EMAIL=anshayurveda@gmail.com

# पता
VITE_ADDRESS=शॉप नंबर 12, शिवम कॉम्प्लेक्स, न्यू राणपुर, अहमदाबाद, गुजरात – 380015

# Facebook Pixel ID (यहाँ अपना Pixel ID डालें, जैसे 123456789012345)
# खाली छोड़ने पर Facebook Pixel लोड नहीं होगा और साइट सामान्य रूप से चलेगी।
VITE_FB_PIXEL_ID=743157388380631

# ---------------------------------------------------------------------------
# Meta Conversions API — सिर्फ़ server side. इन्हें कभी VITE_ prefix न दें।
# असली token सिर्फ़ server की .env फ़ाइल में रखें (यह फ़ाइल git-ignored है)।
# ---------------------------------------------------------------------------
META_PIXEL_ID=743157388380631
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
# Events Manager > Test Events के दौरान भरें; production में खाली रखें।
META_TEST_EVENT_CODE=
# वैकल्पिक: अतिरिक्त allowed origins (comma separated)
META_LEAD_ALLOWED_ORIGINS=
# वैकल्पिक: idempotency फ़ाइलों की जगह (default ./.meta-lead-data)
META_LEAD_STORE_DIR=
PORT=3000
HOST=0.0.0.0
