# Copy this file to .env and fill in the business details for your deployment.
# VITE_ variables are included in the browser bundle; do not put secrets here.
VITE_PHONE_NUMBER=
VITE_WHATSAPP_NUMBER=
VITE_EMAIL=
VITE_ADDRESS=
VITE_FB_PIXEL_ID=743157388380631

# ---------------------------------------------------------------------------
# Meta Conversions API — SERVER SIDE ONLY. Never prefix these with VITE_.
# .env is git-ignored; paste the real access token only into .env on the server.
# ---------------------------------------------------------------------------
META_PIXEL_ID=743157388380631
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
# Only while testing in Events Manager > Test Events. Keep empty in production.
META_TEST_EVENT_CODE=
# Optional: comma separated extra origins allowed to call /api/meta-lead,
# e.g. https://anshayurveda.com,https://www.anshayurveda.com
META_LEAD_ALLOWED_ORIGINS=
# Optional: where idempotency JSON files are stored (default ./.meta-lead-data)
META_LEAD_STORE_DIR=
# Optional: PORT / HOST for `npm start`
PORT=3000
HOST=0.0.0.0
